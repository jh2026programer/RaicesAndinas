# Copia este archivo como .env y completa los valores

PORT=3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=raices_andinas

# Texto aleatorio largo. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# Motor de automatización: vacío = en código (normal); "n8n" = usar los webhooks de n8n
AUTOMATIZACIONES=

# Claves de los servicios (el motor los usa directamente, sin n8n)
# Contraseña de aplicación de Gmail: myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
# Token del bot de Telegram (lo entrega @BotFather)
TELEGRAM_BOT_TOKEN=
# Clave gratuita de Gemini: aistudio.google.com/apikey
GEMINI_API_KEY=
# Plan B de la IA. Clave gratuita de Groq: console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELO=llama-3.3-70b-versatile
# Plan B sin internet (opcional): Ollama instalado en el computador
OLLAMA_URL=
OLLAMA_MODELO=llama3.2
# Correo que recibe las órdenes de compra aprobadas (si está vacío se usa ADMIN_EMAIL)
PROVEEDOR_EMAIL=

N8N_WEBHOOK_URL=http://localhost:5678/webhook
# Texto aleatorio largo; debe coincidir con la credencial "Raices Andinas API" en n8n
AUTOMATION_API_KEY=

# Datos que usan las automatizaciones
TIENDA_EMAIL_REMITENTE=
ADMIN_EMAIL=
ADMIN_TELEGRAM_CHAT_ID=
TIENDA_URL=http://localhost:3000

# Minutos de espera antes de enviar la encuesta (4320 = 3 días; 2 para pruebas)
ENCUESTA_ESPERA_MINUTOS=4320
# Chatbot con IA (true/false) y modelo de Gemini
CHATBOT_IA=true
GEMINI_MODELO=models/gemini-3.8-flash
